<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg">

    <!-- ====================================================== -->
    <!-- BARRA SUPERIOR                                         -->
    <!-- ====================================================== -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NV Drone Mapping"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ====================================================== -->
    <!-- MAPA                                                   -->
    <!-- ====================================================== -->

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- BOTÕES SUPERIORES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:padding="7dp">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="2dp"
                android:text="DESFAZER"
                android:textSize="10sp" />

            <Space
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="2dp"
                android:text="LIMPAR"
                android:textSize="10sp" />

            <Space
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="2dp"
                android:text="IMPORTAR"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- BOTÕES FLUTUANTES -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnFitBoundary"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="@color/navy"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▣"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnMyLocation"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:backgroundTint="@color/navy"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="⌖"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- MENSAGEM DO MAPA -->

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="62dp"
            android:layout_marginBottom="10dp"
            android:background="#CC0D2137"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="Toque no mapa para desenhar o perímetro"
            android:textColor="@color/white"
            android:textSize="10sp" />

    </FrameLayout>

    <!-- ====================================================== -->
    <!-- PAINEL INFERIOR                                        -->
    <!-- ====================================================== -->

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="350dp"
        android:background="@color/white"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingTop="8dp"
            android:paddingEnd="9dp"
            android:paddingBottom="16dp">

            <!-- ================================================== -->
            <!-- PLANEJAMENTO                                      -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLANEJAMENTO DO VOO"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ALTURA / VELOCIDADE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Altura (m)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inAltitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="60"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Veloc. (m/s)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="5"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- SOBREPOSIÇÃO / DIREÇÃO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Frontal (%)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inFrontOverlap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="80"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Lateral (%)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inSideOverlap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="70"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Direção (°)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inBearing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:text="0"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- OPÇÕES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkAutoBearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="0dp"
                    android:text="Direção auto"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/checkCrossHatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="Grade cruzada"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- PRESETS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreset2d"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="2D AUTO"
                    android:textSize="10sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnPreset3d"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="CRUZADO"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- ================================================== -->
            <!-- LINHAS DE VOO                                     -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LINHAS DE VOO"
                android:textColor="@color/navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBearingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="#EEF3F8"
                android:padding="6dp"
                android:text="Linhas: direção automática"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <!-- ROTAÇÃO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRotateLeft"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.75"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="-15°"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="2"
                    android:backgroundTint="@color/navy"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="APLICAR PLANO"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnRotateRight"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.75"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="+15°"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- INVERTER ROTA -->

            <Button
                android:id="@+id/btnReverseRoute"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="2dp"
                android:text="⇄  INVERTER ROTA"
                android:textSize="10sp" />

            <!-- ================================================== -->
            <!-- AVANÇADO                                          -->
            <!-- ================================================== -->

            <Button
                android:id="@+id/btnToggleAdvanced"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="7dp"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="AVANÇADO ▼"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/advancedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURAÇÕES DJI FLY"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <!-- GIMBAL -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Gimbal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inGimbal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:text="-90"
                            android:textSize="12sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="1dp" />

                    <!-- MÁXIMO DE PONTOS -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Máx. pts">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inMaxWaypoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="190"
                            android:textSize="12sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="1dp" />

                    <!-- CÓDIGO DJI -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Cód. DJI">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inDroneEnum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="68"
                            android:textSize="12sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Gimbal -90° = câmera para baixo • Máx. pontos = 190 • Código DJI = 68"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- ================================================== -->
            <!-- RESULTADOS                                        -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RESULTADOS"
                android:textColor="@color/navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="#EEF3F8"
                android:padding="8dp"
                android:text="Área: -- | Perímetro: -- | GSD: -- | Fotos: -- | Tempo: --"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <!-- ================================================== -->
            <!-- MISSÃO DJI                                        -->
            <!-- ================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MISSÃO DJI"
                android:textColor="@color/navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.2"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="EXPORTAR KMZ"
                    android:textSize="10sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnPreviewKml"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="PRÉVIA KML"
                    android:textSize="10sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnDjiGuide"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.9"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="GUIA DJI"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- ================================================== -->
            <!-- PROJETOS                                          -->
            <!-- ================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveProject"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="SALVAR"
                    android:textSize="10sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnOpenProject"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="PROJETOS"
                    android:textSize="10sp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="2dp"
                    android:text="COMPARTILHAR"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
